<?php

namespace Tests\Feature;

use App\Models\AiAgent;
use App\Models\Category;
use App\Models\Order;
use App\Models\Payment;
use App\Models\Product;
use App\Models\QrisTransaction;
use App\Models\Store;
use App\Models\SubMerchant;
use App\Models\User;
use App\Models\WhatsAppAccount;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Illuminate\Support\Facades\Http;
use PHPUnit\Framework\Attributes\Group;
use Tests\TestCase;

/**
 * Integration test for AI Agent Order Flow
 *
 * Tests Requirements: 4.1, 4.2, 4.3, 4.4, 4.5, 4.6, 5.1, 5.2, 5.3, 5.4, 5.5, 5.6
 */
#[Group('skip')]
class AiAgentOrderFlowIntegrationTest extends TestCase
{
    use RefreshDatabase;

    protected User $user;

    protected WhatsAppAccount $whatsappAccount;

    protected AiAgent $aiAgent;

    protected Store $store;

    protected Product $product1;

    protected Product $product2;

    protected function setUp(): void
    {
        parent::setUp();

        // Create test user
        $this->user = User::factory()->create();

        // Create WhatsApp account
        $this->whatsappAccount = WhatsAppAccount::factory()->create([
            'user_id' => $this->user->id,
        ]);

        // Create store
        $this->store = Store::create([
            'user_id' => $this->user->id,
            'name' => 'Test Restaurant',
            'code' => 'TEST001',
            'address' => 'Test Address',
            'phone' => '081234567890',
        ]);

        // Create category
        $category = Category::create([
            'user_id' => $this->user->id,
            'store_id' => $this->store->id,
            'name' => 'Main Course',
        ]);

        // Create test products
        $this->product1 = Product::create([
            'user_id' => $this->user->id,
            'store_id' => $this->store->id,
            'category_id' => $category->id,
            'name' => 'Nasi Goreng',
            'sku' => 'NG001',
            'price' => 25000,
            'stock_quantity' => 100,
            'is_active' => true,
        ]);

        $this->product2 = Product::create([
            'user_id' => $this->user->id,
            'store_id' => $this->store->id,
            'category_id' => $category->id,
            'name' => 'Mie Goreng',
            'sku' => 'MG001',
            'price' => 20000,
            'stock_quantity' => 50,
            'is_active' => true,
        ]);

        // Create AI Agent
        $this->aiAgent = AiAgent::create([
            'whatsapp_account_id' => $this->whatsappAccount->id,
            'bot_name' => 'Test Bot',
            'system_prompt' => 'You are a helpful assistant',
            'business_info' => 'Test Restaurant',
            'default_store_id' => $this->store->id,
            'order_enabled' => true,
            'qris_enabled' => false,
            'is_active' => true,
        ]);

        // Mock LLM API responses
        $this->mockLLMResponses();
    }

    protected function mockLLMResponses(): void
    {
        // Mock LLM API responses - use wildcard to match any API URL (OpenAI, BytePlus, etc.)
        Http::fake([
            '*chat/completions*' => Http::sequence()
                // Response 1: Search products
                ->push([
                    'choices' => [
                        [
                            'message' => [
                                'role' => 'assistant',
                                'content' => null,
                                'tool_calls' => [
                                    [
                                        'id' => 'call_1',
                                        'type' => 'function',
                                        'function' => [
                                            'name' => 'search_products',
                                            'arguments' => json_encode(['query' => 'nasi goreng']),
                                        ],
                                    ],
                                ],
                            ],
                            'finish_reason' => 'tool_calls',
                        ],
                    ],
                ], 200)
                // Response 2: Add to cart
                ->push([
                    'choices' => [
                        [
                            'message' => [
                                'role' => 'assistant',
                                'content' => null,
                                'tool_calls' => [
                                    [
                                        'id' => 'call_2',
                                        'type' => 'function',
                                        'function' => [
                                            'name' => 'add_to_cart',
                                            'arguments' => json_encode([
                                                'product_id' => $this->product1->id,
                                                'quantity' => 2,
                                            ]),
                                        ],
                                    ],
                                ],
                            ],
                            'finish_reason' => 'tool_calls',
                        ],
                    ],
                ], 200)
                // Response 3: Get cart summary
                ->push([
                    'choices' => [
                        [
                            'message' => [
                                'role' => 'assistant',
                                'content' => null,
                                'tool_calls' => [
                                    [
                                        'id' => 'call_3',
                                        'type' => 'function',
                                        'function' => [
                                            'name' => 'get_cart_summary',
                                            'arguments' => json_encode([]),
                                        ],
                                    ],
                                ],
                            ],
                            'finish_reason' => 'tool_calls',
                        ],
                    ],
                ], 200)
                // Response 4: Confirm order
                ->push([
                    'choices' => [
                        [
                            'message' => [
                                'role' => 'assistant',
                                'content' => null,
                                'tool_calls' => [
                                    [
                                        'id' => 'call_4',
                                        'type' => 'function',
                                        'function' => [
                                            'name' => 'confirm_order',
                                            'arguments' => json_encode([]),
                                        ],
                                    ],
                                ],
                            ],
                            'finish_reason' => 'tool_calls',
                        ],
                    ],
                ], 200),
        ]);
    }

    /**
     * Test complete order flow via test endpoint
     *
     * Requirements: 4.1, 4.2, 4.3, 4.4, 4.5, 4.6
     */
    public function test_complete_order_flow_via_test_endpoint(): void
    {
        // Step 1: Search products - "Cari menu nasi goreng"
        $response1 = $this->actingAs($this->user, 'sanctum')
            ->postJson('/api/ai-agent/test', [
                'message' => 'Cari menu nasi goreng',
            ]);

        $response1->assertStatus(200);
        $response1->assertJson([
            'success' => true,
        ]);

        $data1 = $response1->json('data');
        $this->assertArrayHasKey('conversation_history', $data1);
        $this->assertIsArray($data1['conversation_history']);
        $this->assertGreaterThanOrEqual(2, count($data1['conversation_history']));

        // Verify user message stored
        $userMessage = collect($data1['conversation_history'])->firstWhere('role', 'user');
        $this->assertNotNull($userMessage);
        $this->assertEquals('Cari menu nasi goreng', $userMessage['content']);

        // Verify assistant response contains product info
        $assistantMessage = collect($data1['conversation_history'])->where('role', 'assistant')->last();
        $this->assertNotNull($assistantMessage);
        $this->assertStringContainsString('Nasi Goreng', $assistantMessage['content']);

        // Step 2: Add to cart - "Pesan 2 nasi goreng"
        $response2 = $this->actingAs($this->user, 'sanctum')
            ->postJson('/api/ai-agent/test', [
                'message' => 'Pesan 2 nasi goreng',
            ]);

        $response2->assertStatus(200);
        $response2->assertJson([
            'success' => true,
        ]);

        $data2 = $response2->json('data');
        $this->assertStringContainsString('keranjang', strtolower($data2['ai_response']));

        // Step 3: View cart - "Lihat keranjang"
        $response3 = $this->actingAs($this->user, 'sanctum')
            ->postJson('/api/ai-agent/test', [
                'message' => 'Lihat keranjang',
            ]);

        $response3->assertStatus(200);
        $response3->assertJson([
            'success' => true,
        ]);

        $data3 = $response3->json('data');
        $this->assertStringContainsString('Nasi Goreng', $data3['ai_response']);
        $this->assertStringContainsString('50.000', $data3['ai_response']); // 2 x 25000 formatted

        // Step 4: Confirm order - "Konfirmasi pesanan"
        $response4 = $this->actingAs($this->user, 'sanctum')
            ->postJson('/api/ai-agent/test', [
                'message' => 'Konfirmasi pesanan',
            ]);

        $response4->assertStatus(200);
        $response4->assertJson([
            'success' => true,
        ]);

        $data4 = $response4->json('data');
        // Accept various confirmation indicators - AI might say "Berhasil", "dikonfirmasi", "confirmed", etc.
        $hasConfirmation = str_contains(strtolower($data4['ai_response']), 'berhasil')
            || str_contains(strtolower($data4['ai_response']), 'dikonfirmasi')
            || str_contains(strtolower($data4['ai_response']), 'konfirmasi')
            || str_contains(strtolower($data4['ai_response']), 'pesanan anda');
        $this->assertTrue($hasConfirmation, 'AI response should indicate order confirmation');

        // Verify order created in database
        $order = Order::where('store_id', $this->store->id)
            ->where('source', Order::SOURCE_WHATSAPP_AI)
            ->first();

        $this->assertNotNull($order, 'Order should be created in database');
        $this->assertEquals($this->store->id, $order->store_id);
        $this->assertEquals(Order::SOURCE_WHATSAPP_AI, $order->source);

        // Verify order items created
        $this->assertCount(1, $order->items);
        $orderItem = $order->items->first();
        $this->assertEquals($this->product1->id, $orderItem->product_id);
        $this->assertEquals(2, $orderItem->quantity);
        $this->assertEquals(25000, $orderItem->unit_price);

        // Verify conversation_history formatted correctly
        $this->assertIsArray($data4['conversation_history']);
        $this->assertGreaterThan(0, count($data4['conversation_history']));

        foreach ($data4['conversation_history'] as $message) {
            $this->assertArrayHasKey('role', $message);
            $this->assertArrayHasKey('content', $message);
            $this->assertArrayHasKey('timestamp', $message);
            $this->assertContains($message['role'], ['user', 'assistant']);
        }
    }

    /**
     * Test QRIS flow via test endpoint
     *
     * Requirements: 5.1, 5.2, 5.3, 5.4, 5.5, 5.6
     */
    public function test_qris_flow_via_test_endpoint(): void
    {
        // Enable QRIS for AI Agent
        $this->aiAgent->qris_enabled = true;
        $this->aiAgent->save();

        // Create SubMerchant for user
        $subMerchant = SubMerchant::create([
            'user_id' => $this->user->id,
            'merchant_name' => 'Test Merchant',
            'merchant_email' => 'test@example.com',
            'merchant_phone' => '081234567890',
            'account_number' => '1234567890',
            'account_holder_name' => 'Test Holder',
            'bank_code' => 'BCA',
            'is_active' => true,
        ]);

        // Mock QRIS provider response
        Http::fake([
            'https://api.openai.com/v1/chat/completions' => Http::sequence()
                // Response 1: Create order first
                ->push([
                    'choices' => [
                        [
                            'message' => [
                                'role' => 'assistant',
                                'content' => null,
                                'tool_calls' => [
                                    [
                                        'id' => 'call_1',
                                        'type' => 'function',
                                        'function' => [
                                            'name' => 'add_to_cart',
                                            'arguments' => json_encode([
                                                'product_id' => $this->product1->id,
                                                'quantity' => 1,
                                            ]),
                                        ],
                                    ],
                                ],
                            ],
                            'finish_reason' => 'tool_calls',
                        ],
                    ],
                ], 200)
                ->push([
                    'choices' => [
                        [
                            'message' => [
                                'role' => 'assistant',
                                'content' => null,
                                'tool_calls' => [
                                    [
                                        'id' => 'call_2',
                                        'type' => 'function',
                                        'function' => [
                                            'name' => 'confirm_order',
                                            'arguments' => json_encode([]),
                                        ],
                                    ],
                                ],
                            ],
                            'finish_reason' => 'tool_calls',
                        ],
                    ],
                ], 200)
                // Response 2: Generate QRIS
                ->push([
                    'choices' => [
                        [
                            'message' => [
                                'role' => 'assistant',
                                'content' => null,
                                'tool_calls' => [
                                    [
                                        'id' => 'call_3',
                                        'type' => 'function',
                                        'function' => [
                                            'name' => 'generate_qris',
                                            'arguments' => json_encode([
                                                'amount' => 50000,
                                            ]),
                                        ],
                                    ],
                                ],
                            ],
                            'finish_reason' => 'tool_calls',
                        ],
                    ],
                ], 200)
                // Response 3: Check status
                ->push([
                    'choices' => [
                        [
                            'message' => [
                                'role' => 'assistant',
                                'content' => null,
                                'tool_calls' => [
                                    [
                                        'id' => 'call_4',
                                        'type' => 'function',
                                        'function' => [
                                            'name' => 'check_payment_status',
                                            'arguments' => json_encode([]),
                                        ],
                                    ],
                                ],
                            ],
                            'finish_reason' => 'tool_calls',
                        ],
                    ],
                ], 200),
            '*' => Http::response([
                'qr_string' => '00020101021226660014ID.CO.QRIS.WWW0118ID1234567890123456020350000303UME51440014ID.CO.QRIS.WWW0215ID20200123456780303UME5204581253033605802ID5914Test Merchant6007Jakarta61051234062070703A0163044C4D',
                'qr_code_url' => 'https://example.com/qr/test123.png',
            ], 200),
        ]);

        // Step 1: Add product and create order
        $response1 = $this->actingAs($this->user, 'sanctum')
            ->postJson('/api/ai-agent/test', [
                'message' => 'Pesan 1 nasi goreng',
            ]);

        $response1->assertStatus(200);

        $response2 = $this->actingAs($this->user, 'sanctum')
            ->postJson('/api/ai-agent/test', [
                'message' => 'Konfirmasi pesanan',
            ]);

        $response2->assertStatus(200);

        // Verify order created
        $order = Order::where('store_id', $this->store->id)->first();
        $this->assertNotNull($order);

        // Step 2: Generate QRIS - "Buat QRIS 50000"
        $response3 = $this->actingAs($this->user, 'sanctum')
            ->postJson('/api/ai-agent/test', [
                'message' => 'Buat QRIS 50000',
            ]);

        $response3->assertStatus(200);
        $response3->assertJson([
            'success' => true,
        ]);

        $data3 = $response3->json('data');
        $this->assertStringContainsString('QRIS', $data3['ai_response']);
        $this->assertStringContainsString('50', $data3['ai_response']);

        // Verify QRIS transaction created
        $qrisTransaction = QrisTransaction::where('sub_merchant_id', $subMerchant->id)->first();
        $this->assertNotNull($qrisTransaction, 'QRIS transaction should be created');
        $this->assertEquals(50000, $qrisTransaction->amount);

        // Verify linked to order
        $this->assertEquals($order->id, $qrisTransaction->linked_order_id);

        // Verify Payment record created
        $payment = Payment::where('order_id', $order->id)
            ->where('qris_transaction_id', $qrisTransaction->id)
            ->first();
        $this->assertNotNull($payment, 'Payment record should link order and QRIS transaction');

        // Step 3: Check status - "Cek status"
        $response4 = $this->actingAs($this->user, 'sanctum')
            ->postJson('/api/ai-agent/test', [
                'message' => 'Cek status',
            ]);

        $response4->assertStatus(200);
        $response4->assertJson([
            'success' => true,
        ]);

        $data4 = $response4->json('data');
        // Should show pending status
        $this->assertStringContainsString('Menunggu', $data4['ai_response']);
    }
}
