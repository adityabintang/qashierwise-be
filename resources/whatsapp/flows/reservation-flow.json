{
    "version": "7.3",
    "data_api_version": "3.0",
    "routing_model": {
        "APPOINTMENT": ["DETAILS"],
        "DETAILS": ["SUMMARY"],
        "SUMMARY": ["PAYMENT"],
        "PAYMENT": []
    },
    "screens": [
        {
            "id": "APPOINTMENT",
            "title": "Reservasi",
            "data": {
                "dates": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": { "type": "string" },
                            "title": { "type": "string" }
                        }
                    },
                    "__example__": [
                        { "id": "2026-01-02", "title": "Jum, 02 Jan 2026" },
                        { "id": "2026-01-03", "title": "Sab, 03 Jan 2026" },
                        { "id": "2026-01-04", "title": "Min, 04 Jan 2026" }
                    ]
                },
                "times": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": { "type": "string" },
                            "title": { "type": "string" },
                            "enabled": { "type": "boolean" }
                        }
                    },
                    "__example__": [
                        { "id": "10:00", "title": "10:00 WIB" },
                        { "id": "11:00", "title": "11:00 WIB" },
                        { "id": "12:00", "title": "12:00 WIB", "enabled": false },
                        { "id": "13:00", "title": "13:00 WIB" }
                    ]
                },
                "is_time_enabled": {
                    "type": "boolean",
                    "__example__": false
                }
            },
            "layout": {
                "type": "SingleColumnLayout",
                "children": [
                    {
                        "type": "Form",
                        "name": "appointment_form",
                        "children": [
                            {
                                "type": "TextSubheading",
                                "text": "📅 Pilih Waktu Reservasi"
                            },
                            {
                                "type": "Dropdown",
                                "label": "Tanggal Reservasi",
                                "name": "reservation_date",
                                "data-source": "${data.dates}",
                                "required": true,
                                "on-select-action": {
                                    "name": "data_exchange",
                                    "payload": {
                                        "trigger": "date_selected",
                                        "reservation_date": "${form.reservation_date}"
                                    }
                                }
                            },
                            {
                                "type": "Dropdown",
                                "label": "Jam Reservasi",
                                "name": "reservation_time",
                                "data-source": "${data.times}",
                                "required": "${data.is_time_enabled}",
                                "enabled": "${data.is_time_enabled}"
                            },
                            {
                                "type": "TextSubheading",
                                "text": "👤 Data Pemesan"
                            },
                            {
                                "type": "TextInput",
                                "name": "customer_name",
                                "label": "Nama Lengkap",
                                "required": true,
                                "input-type": "text",
                                "helper-text": "Nama untuk reservasi"
                            },
                            {
                                "type": "TextInput",
                                "name": "phone",
                                "label": "Nomor WhatsApp",
                                "required": true,
                                "input-type": "phone",
                                "helper-text": "Untuk konfirmasi & reminder"
                            },
                            {
                                "type": "TextInput",
                                "name": "guest_count",
                                "label": "Jumlah Tamu",
                                "required": true,
                                "input-type": "number",
                                "helper-text": "Berapa orang yang akan hadir?"
                            },
                            {
                                "type": "Footer",
                                "label": "Lanjutkan",
                                "on-click-action": {
                                    "name": "data_exchange",
                                    "payload": {
                                        "trigger": "appointment_submitted",
                                        "reservation_date": "${form.reservation_date}",
                                        "reservation_time": "${form.reservation_time}",
                                        "customer_name": "${form.customer_name}",
                                        "phone": "${form.phone}",
                                        "guest_count": "${form.guest_count}"
                                    }
                                }
                            }
                        ]
                    }
                ]
            }
        },
        {
            "id": "DETAILS",
            "title": "Detail Reservasi",
            "data": {
                "reservation_date": {
                    "type": "string",
                    "__example__": "2026-01-02"
                },
                "reservation_time": {
                    "type": "string",
                    "__example__": "12:00"
                },
                "customer_name": {
                    "type": "string",
                    "__example__": "John Doe"
                },
                "phone": {
                    "type": "string",
                    "__example__": "081234567890"
                },
                "guest_count": {
                    "type": "string",
                    "__example__": "4"
                },
                "event_types": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": { "type": "string" },
                            "title": { "type": "string" }
                        }
                    },
                    "__example__": [
                        { "id": "regular", "title": "Makan biasa" },
                        { "id": "birthday", "title": "Ulang Tahun" },
                        { "id": "meeting", "title": "Meeting/Bisnis" },
                        { "id": "anniversary", "title": "Anniversary" },
                        { "id": "other", "title": "Lainnya" }
                    ]
                },
                "products": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": { "type": "string" },
                            "title": { "type": "string" }
                        }
                    },
                    "__example__": [
                        { "id": "1", "title": "Nasi Goreng - Rp25.000" },
                        { "id": "2", "title": "Mie Goreng - Rp22.000" },
                        { "id": "3", "title": "Ayam Bakar - Rp35.000" }
                    ]
                },
                "tables": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": { "type": "string" },
                            "title": { "type": "string" }
                        }
                    },
                    "__example__": [
                        { "id": "1", "title": "Meja 1 (4 orang)" },
                        { "id": "2", "title": "Meja 2 (6 orang)" },
                        { "id": "3", "title": "Meja 3 (8 orang)" }
                    ]
                }
            },
            "layout": {
                "type": "SingleColumnLayout",
                "children": [
                    {
                        "type": "Form",
                        "name": "details_form",
                        "children": [
                            {
                                "type": "TextSubheading",
                                "text": "📝 Informasi Tambahan"
                            },
                            {
                                "type": "TextInput",
                                "name": "email",
                                "label": "Email",
                                "required": false,
                                "input-type": "email",
                                "helper-text": "Untuk konfirmasi tertulis (opsional)"
                            },
                            {
                                "type": "Dropdown",
                                "label": "Tipe Acara",
                                "name": "event_type",
                                "data-source": "${data.event_types}",
                                "required": false
                            },
                            {
                                "type": "TextArea",
                                "name": "special_notes",
                                "label": "Catatan Khusus",
                                "required": false,
                                "helper-text": "Alergi makanan, permintaan khusus, dll"
                            },
                            {
                                "type": "TextSubheading",
                                "text": "🍽️ Pre-Order Menu"
                            },
                            {
                                "type": "CheckboxGroup",
                                "name": "selected_products",
                                "label": "Pilih Menu (opsional)",
                                "data-source": "${data.products}",
                                "required": false
                            },
                            {
                                "type": "TextSubheading",
                                "text": "🪑 Pilih Meja"
                            },
                            {
                                "type": "Dropdown",
                                "label": "Meja",
                                "name": "table_id",
                                "data-source": "${data.tables}",
                                "required": true
                            },
                            {
                                "type": "Footer",
                                "label": "Lihat Ringkasan",
                                "on-click-action": {
                                    "name": "data_exchange",
                                    "payload": {
                                        "trigger": "details_submitted",
                                        "reservation_date": "${data.reservation_date}",
                                        "reservation_time": "${data.reservation_time}",
                                        "customer_name": "${data.customer_name}",
                                        "phone": "${data.phone}",
                                        "guest_count": "${data.guest_count}",
                                        "email": "${form.email}",
                                        "event_type": "${form.event_type}",
                                        "special_notes": "${form.special_notes}",
                                        "selected_products": "${form.selected_products}",
                                        "table_id": "${form.table_id}"
                                    }
                                }
                            }
                        ]
                    }
                ]
            }
        },
        {
            "id": "SUMMARY",
            "title": "Ringkasan",
            "data": {
                "reservation_date": {
                    "type": "string",
                    "__example__": "2026-01-02"
                },
                "reservation_time": {
                    "type": "string",
                    "__example__": "12:00"
                },
                "customer_name": {
                    "type": "string",
                    "__example__": "John Doe"
                },
                "phone": {
                    "type": "string",
                    "__example__": "081234567890"
                },
                "guest_count": {
                    "type": "string",
                    "__example__": "4"
                },
                "email": {
                    "type": "string",
                    "__example__": "john@example.com"
                },
                "event_type": {
                    "type": "string",
                    "__example__": "birthday"
                },
                "special_notes": {
                    "type": "string",
                    "__example__": "Tolong siapkan kue ulang tahun"
                },
                "selected_products": {
                    "type": "array",
                    "items": { "type": "string" },
                    "__example__": ["1", "2", "3"]
                },
                "table_id": {
                    "type": "string",
                    "__example__": "1"
                },
                "appointment_summary": {
                    "type": "string",
                    "__example__": "📅 Jum, 02 Jan 2026 jam 12:00 WIB\n👤 John Doe (081234567890)\n👥 4 tamu\n🎂 Ulang Tahun"
                },
                "menu_summary": {
                    "type": "string",
                    "__example__": "🍽️ Menu yang dipilih:\n• Nasi Goreng - Rp25.000\n• Mie Goreng - Rp22.000\n• Ayam Bakar - Rp35.000"
                },
                "table_summary": {
                    "type": "string",
                    "__example__": "🪑 Meja 1 (4 orang)"
                },
                "price_breakdown": {
                    "type": "string",
                    "__example__": "💰 Rincian Biaya:\nTotal Menu: Rp82.000\nBiaya Reservasi Meja: Rp100.000\n─────────────────\nTotal: Rp182.000\nDP Minimal (50%): Rp91.000"
                },
                "menu_total": {
                    "type": "string",
                    "__example__": "82000"
                },
                "table_fee": {
                    "type": "string",
                    "__example__": "100000"
                },
                "grand_total": {
                    "type": "string",
                    "__example__": "182000"
                },
                "dp_amount": {
                    "type": "string",
                    "__example__": "91000"
                }
            },
            "layout": {
                "type": "SingleColumnLayout",
                "children": [
                    {
                        "type": "Form",
                        "name": "summary_form",
                        "children": [
                            {
                                "type": "TextHeading",
                                "text": "📋 Ringkasan Reservasi"
                            },
                            {
                                "type": "TextBody",
                                "text": "${data.appointment_summary}"
                            },
                            {
                                "type": "TextBody",
                                "text": "${data.table_summary}"
                            },
                            {
                                "type": "TextBody",
                                "text": "${data.menu_summary}"
                            },
                            {
                                "type": "TextBody",
                                "text": "${data.price_breakdown}"
                            },
                            {
                                "type": "Footer",
                                "label": "Lanjut ke Pembayaran",
                                "on-click-action": {
                                    "name": "navigate",
                                    "next": {
                                        "type": "screen",
                                        "name": "PAYMENT"
                                    },
                                    "payload": {
                                        "reservation_date": "${data.reservation_date}",
                                        "reservation_time": "${data.reservation_time}",
                                        "customer_name": "${data.customer_name}",
                                        "phone": "${data.phone}",
                                        "guest_count": "${data.guest_count}",
                                        "email": "${data.email}",
                                        "event_type": "${data.event_type}",
                                        "special_notes": "${data.special_notes}",
                                        "selected_products": "${data.selected_products}",
                                        "table_id": "${data.table_id}",
                                        "menu_total": "${data.menu_total}",
                                        "table_fee": "${data.table_fee}",
                                        "grand_total": "${data.grand_total}",
                                        "dp_amount": "${data.dp_amount}"
                                    }
                                }
                            }
                        ]
                    }
                ]
            }
        },
        {
            "id": "PAYMENT",
            "title": "Pembayaran",
            "terminal": true,
            "data": {
                "reservation_date": {
                    "type": "string",
                    "__example__": "2026-01-02"
                },
                "reservation_time": {
                    "type": "string",
                    "__example__": "12:00"
                },
                "customer_name": {
                    "type": "string",
                    "__example__": "John Doe"
                },
                "phone": {
                    "type": "string",
                    "__example__": "081234567890"
                },
                "guest_count": {
                    "type": "string",
                    "__example__": "4"
                },
                "email": {
                    "type": "string",
                    "__example__": "john@example.com"
                },
                "event_type": {
                    "type": "string",
                    "__example__": "birthday"
                },
                "special_notes": {
                    "type": "string",
                    "__example__": "Tolong siapkan kue ulang tahun"
                },
                "selected_products": {
                    "type": "array",
                    "items": { "type": "string" },
                    "__example__": ["1", "2", "3"]
                },
                "table_id": {
                    "type": "string",
                    "__example__": "1"
                },
                "menu_total": {
                    "type": "string",
                    "__example__": "82000"
                },
                "table_fee": {
                    "type": "string",
                    "__example__": "100000"
                },
                "grand_total": {
                    "type": "string",
                    "__example__": "182000"
                },
                "dp_amount": {
                    "type": "string",
                    "__example__": "91000"
                },
                "payment_types": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": { "type": "string" },
                            "title": { "type": "string" }
                        }
                    },
                    "__example__": [
                        { "id": "dp", "title": "DP (50%) - Rp91.000" },
                        { "id": "lunas", "title": "Lunas - Rp182.000" }
                    ]
                },
                "payment_methods": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": { "type": "string" },
                            "title": { "type": "string" }
                        }
                    },
                    "__example__": [
                        { "id": "qris", "title": "QRIS" },
                        { "id": "cash", "title": "Bayar di Tempat (Cash)" }
                    ]
                },
                "is_payment_method_enabled": {
                    "type": "boolean",
                    "__example__": false
                },
                "show_qris": {
                    "type": "boolean",
                    "__example__": false
                },
                "qr_code_url": {
                    "type": "string",
                    "__example__": ""
                },
                "payment_amount": {
                    "type": "string",
                    "__example__": "91000"
                },
                "payment_amount_formatted": {
                    "type": "string",
                    "__example__": "Rp91.000"
                },
                "payment_instruction": {
                    "type": "string",
                    "__example__": "Silakan pilih jenis pembayaran"
                }
            },
            "layout": {
                "type": "SingleColumnLayout",
                "children": [
                    {
                        "type": "Form",
                        "name": "payment_form",
                        "children": [
                            {
                                "type": "TextHeading",
                                "text": "💳 Pembayaran"
                            },
                            {
                                "type": "TextBody",
                                "text": "${data.payment_instruction}"
                            },
                            {
                                "type": "Dropdown",
                                "label": "Jenis Pembayaran",
                                "name": "payment_type",
                                "data-source": "${data.payment_types}",
                                "required": true,
                                "on-select-action": {
                                    "name": "data_exchange",
                                    "payload": {
                                        "trigger": "payment_type_selected",
                                        "reservation_date": "${data.reservation_date}",
                                        "reservation_time": "${data.reservation_time}",
                                        "customer_name": "${data.customer_name}",
                                        "phone": "${data.phone}",
                                        "guest_count": "${data.guest_count}",
                                        "email": "${data.email}",
                                        "event_type": "${data.event_type}",
                                        "special_notes": "${data.special_notes}",
                                        "selected_products": "${data.selected_products}",
                                        "table_id": "${data.table_id}",
                                        "menu_total": "${data.menu_total}",
                                        "table_fee": "${data.table_fee}",
                                        "grand_total": "${data.grand_total}",
                                        "dp_amount": "${data.dp_amount}",
                                        "payment_type": "${form.payment_type}"
                                    }
                                }
                            },
                            {
                                "type": "Dropdown",
                                "label": "Metode Pembayaran",
                                "name": "payment_method",
                                "data-source": "${data.payment_methods}",
                                "required": "${data.is_payment_method_enabled}",
                                "enabled": "${data.is_payment_method_enabled}",
                                "on-select-action": {
                                    "name": "data_exchange",
                                    "payload": {
                                        "trigger": "payment_method_selected",
                                        "reservation_date": "${data.reservation_date}",
                                        "reservation_time": "${data.reservation_time}",
                                        "customer_name": "${data.customer_name}",
                                        "phone": "${data.phone}",
                                        "guest_count": "${data.guest_count}",
                                        "email": "${data.email}",
                                        "event_type": "${data.event_type}",
                                        "special_notes": "${data.special_notes}",
                                        "selected_products": "${data.selected_products}",
                                        "table_id": "${data.table_id}",
                                        "menu_total": "${data.menu_total}",
                                        "table_fee": "${data.table_fee}",
                                        "grand_total": "${data.grand_total}",
                                        "dp_amount": "${data.dp_amount}",
                                        "payment_type": "${form.payment_type}",
                                        "payment_method": "${form.payment_method}"
                                    }
                                }
                            },
                            {
                                "type": "EmbeddedLink",
                                "text": "Scan QRIS untuk membayar ${data.payment_amount_formatted}",
                                "on-click-action": {
                                    "name": "open_url",
                                    "url": "${data.qr_code_url}"
                                },
                                "visible": "${data.show_qris}"
                            },
                            {
                                "type": "Footer",
                                "label": "Konfirmasi Reservasi",
                                "on-click-action": {
                                    "name": "complete",
                                    "payload": {
                                        "reservation_date": "${data.reservation_date}",
                                        "reservation_time": "${data.reservation_time}",
                                        "customer_name": "${data.customer_name}",
                                        "phone": "${data.phone}",
                                        "guest_count": "${data.guest_count}",
                                        "email": "${data.email}",
                                        "event_type": "${data.event_type}",
                                        "special_notes": "${data.special_notes}",
                                        "selected_products": "${data.selected_products}",
                                        "table_id": "${data.table_id}",
                                        "menu_total": "${data.menu_total}",
                                        "table_fee": "${data.table_fee}",
                                        "grand_total": "${data.grand_total}",
                                        "dp_amount": "${data.dp_amount}",
                                        "payment_type": "${form.payment_type}",
                                        "payment_method": "${form.payment_method}",
                                        "payment_amount": "${data.payment_amount}"
                                    }
                                }
                            }
                        ]
                    }
                ]
            }
        }
    ]
}
