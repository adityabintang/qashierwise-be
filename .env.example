APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=r2
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@qashierwise.com"
MAIL_FROM_NAME="${APP_NAME}"

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# OTP Configuration
OTP_EXPIRATION_MINUTES=10
OTP_LENGTH=6
OTP_RATE_LIMIT_MAX=3
OTP_RATE_LIMIT_MINUTES=1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 Storage
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=whatsapp
R2_ENDPOINT=
R2_URL=
R2_REGION=auto

VITE_APP_NAME="${APP_NAME}"

# WhatsApp Business API Configuration
WHATSAPP_API_VERSION=v22.0
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# WhatsApp Embedded Signup v4 Configuration
# Config ID from Meta Developer Console for Embedded Signup
# ES v4 enables coexistence support (users keep personal WhatsApp while using Cloud API)
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=

# WhatsApp Flow Endpoint Configuration
# Private key for decrypting flow endpoint requests (PEM format, base64 encoded)
WHATSAPP_FLOW_PRIVATE_KEY=
# Passphrase for the private key (if encrypted)
WHATSAPP_FLOW_PASSPHRASE=
# Fixed table reservation fee in IDR
WHATSAPP_FLOW_TABLE_FEE=100000

# Legacy single-account configuration (deprecated - use Embedded Signup instead)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# AI Agent Anti-Spam Configuration
AI_AGENT_RATE_LIMIT_ENABLED=true
AI_AGENT_RATE_LIMIT_MAX=20
AI_AGENT_RATE_LIMIT_TTL=86400
AI_AGENT_DEDUP_ENABLED=true
AI_AGENT_DEDUP_TTL=300
AI_AGENT_SEEN_STATUS_ENABLED=true

# Midtrans Subscription Configuration
SUBSCRIPTION_PROVIDER=midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SUBSCRIPTION_SUCCESS_URL="${APP_URL}/subscription/success"
MIDTRANS_SUBSCRIPTION_CANCEL_URL="${APP_URL}/subscription/cancel"
MIDTRANS_SUBSCRIPTION_ERROR_URL="${APP_URL}/subscription/error"
SUBSCRIPTION_TRIAL_DAYS=14

# Monitoring & Alerting Configuration
MONITORING_ENABLED=true
MONITORING_EMAIL_ALERTS=false
MONITORING_ALERT_EMAILS=admin@example.com
MONITORING_SLACK_ALERTS=false
MONITORING_SLACK_WEBHOOK=
MONITORING_ERROR_RATE_THRESHOLD=0.1
MONITORING_WEBHOOK_FAILURE_THRESHOLD=5
MONITORING_API_TIMEOUT_THRESHOLD=5000
MONITORING_INVALID_SIGNATURE_THRESHOLD=5
MONITORING_METRICS_RETENTION=24
MONITORING_HEALTH_CHECK_ENABLED=true
MONITORING_SUBSCRIPTION_LOG_LEVEL=info
MONITORING_WEBHOOK_LOG_LEVEL=info

# Xendit XenPlatform Configuration
XENDIT_API_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_PLATFORM_FEE=2.5

# Xendit Subscription Configuration
XENDIT_SUBSCRIPTION_SUCCESS_URL=${APP_URL}/subscription/success
XENDIT_SUBSCRIPTION_CANCELLED_URL=${APP_URL}/subscription/cancelled
XENDIT_SUBSCRIPTION_ERROR_URL=${APP_URL}/subscription/error
MONITORING_WEBHOOK_LOG_PAYLOAD=false
MONITORING_API_LOG_LEVEL=info
MONITORING_ERROR_LOG_TRACE=true
MONITORING_PERFORMANCE_ENABLED=true
MONITORING_SLOW_QUERY_THRESHOLD=1000
MONITORING_SLOW_API_THRESHOLD=3000

# Google Analytics 4 Configuration
GA_MEASUREMENT_ID=G-4P8WD25LLQ

