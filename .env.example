# Meta Pixel Configuration
# Get your Pixel ID from: https://business.facebook.com/events_manager
# 1. Go to Events Manager
# 2. Select your Pixel
# 3. Copy the Pixel ID (15-16 digit number)
META_PIXEL_ID=

# Meta Conversions API (CAPI) Configuration
# Get your access token from: https://business.facebook.com/events_manager
# 1. Go to Events Manager > Settings > Conversions API
# 2. Generate Access Token
# 3. Copy the token (starts with EAA...)
META_CAPI_TOKEN=

# Meta Test Event Code (Optional - for testing only)
# Get from: Events Manager > Test Events
# Use this to test events before going live
META_TEST_EVENT_CODE=

