# QRIS Multi-Provider Configuration Example
# Copy relevant sections to your .env file

# ============================================================================
# MIDTRANS CONFIGURATION
# ============================================================================
# Get your credentials from: https://dashboard.midtrans.com
# Settings → Access Keys

# Midtrans Server Key (required for server-side operations)
MIDTRANS_SERVER_KEY=your_midtrans_server_key_here

# Midtrans Client Key (required for client-side operations)
MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here

# Environment: true for production, false for sandbox/testing
MIDTRANS_IS_PRODUCTION=false

# ============================================================================
# XENDIT CONFIGURATION
# ============================================================================
# Get your credentials from: https://dashboard.xendit.co
# Settings → Developers → API Keys

# Xendit Secret API Key (used for authentication)
XENDIT_API_KEY=xnd_development_your_api_key_here

# Xendit Webhook Verification Token (used for webhook signature verification)
# Get from: Settings → Developers → Webhooks
XENDIT_SECRET_KEY=your_webhook_verification_token_here

# Xendit API Base URL (usually no need to change)
XENDIT_BASE_URL=https://api.xendit.co

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Application URL (used for webhook callbacks)
APP_URL=https://yourdomain.com

# Webhook URLs (automatically constructed from APP_URL)
# Midtrans: ${APP_URL}/api/webhooks/midtrans
# Xendit: ${APP_URL}/api/webhooks/xendit

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# Application encryption key (used for encrypting provider credentials)
# IMPORTANT: Never change this after storing credentials, or they cannot be decrypted
APP_KEY=base64:your_app_key_here

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level for debugging (debug, info, warning, error)
LOG_LEVEL=info

# Enable detailed provider API logging (useful for debugging)
LOG_PROVIDER_API_CALLS=true

# ============================================================================
# TESTING CONFIGURATION
# ============================================================================

# Use test/sandbox credentials for development
# Midtrans: Use sandbox keys (prefix: SB-)
# Xendit: Use development keys (prefix: xnd_development_)

# Test mode flag (optional, for application logic)
PAYMENT_TEST_MODE=true

# ============================================================================
# NOTES
# ============================================================================

# 1. NEVER commit this file with real credentials to version control
# 2. Use different credentials for development, staging, and production
# 3. Rotate API keys regularly for security
# 4. Keep webhook verification tokens secure
# 5. Use HTTPS for all webhook URLs in production
# 6. Test thoroughly in sandbox/test mode before going live

# ============================================================================
# PROVIDER-SPECIFIC NOTES
# ============================================================================

# MIDTRANS:
# - Sandbox URL: https://api.sandbox.midtrans.com
# - Production URL: https://api.midtrans.com
# - Test cards: https://docs.midtrans.com/en/technical-reference/sandbox-test

# XENDIT:
# - Development keys start with: xnd_development_
# - Production keys start with: xnd_production_
# - Test payment simulator: Dashboard → Developers → Test Payment Simulator

# ============================================================================
# WEBHOOK CONFIGURATION
# ============================================================================

# Configure these URLs in your provider dashboards:

# Midtrans:
# Dashboard → Settings → Configuration → Payment Notification URL
# URL: https://yourdomain.com/api/webhooks/midtrans

# Xendit:
# Dashboard → Settings → Developers → Webhooks → Add Webhook URL
# URL: https://yourdomain.com/api/webhooks/xendit
# Events: qr_code.paid, qr_code.expired

# ============================================================================
# TROUBLESHOOTING
# ============================================================================

# If webhooks are not working:
# 1. Verify webhook URLs are correct in provider dashboards
# 2. Ensure URLs are accessible from internet (not localhost)
# 3. Check webhook verification tokens match
# 4. Review logs: storage/logs/laravel.log
# 5. Test webhooks manually using curl (see docs/WEBHOOK_SETUP_AND_TESTING.md)

# If credentials are invalid:
# 1. Verify you copied the correct keys from provider dashboard
# 2. Ensure you're using the right environment (test/production)
# 3. Check if keys have been revoked or expired
# 4. Verify APP_KEY hasn't changed (would break credential decryption)

# For more help:
# - Check documentation: docs/
# - Review error handling: docs/ERROR_HANDLING.md
# - Xendit docs: https://developers.xendit.co
# - Midtrans docs: https://docs.midtrans.com
